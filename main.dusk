main :: proc() {
    os.console_init()
    defer os.console_deinit()
    allocators.temp_allocator_init(0, allocators.heap_allocator())
    defer allocators.temp_allocator_destroy()
    os.init_args()
    when DUSK_OS == .Windows {
        os.init_long_path_support()
    }

    // ARGS
    if !(os.args.len == 3) {
        os.eprintfln(os.ERROR + "Must have 2 arguments: LINK_FILE (absolute), SOURCE_DIR (absolute)")
        os.exit(1)
    }

    // SOURCE DIR
    source_dir := os.args.data[2]
    set_wd_err := os.set_working_directory(source_dir)
    os.assertf(set_wd_err == nil, "path: %", source_dir)

    // LINK FILE
    link_file  := os.args.data[1]
    data, read_err := os.read_entire_file_from_path(link_file, allocators.heap_allocator()) // allocator to be removed
    defer _ = slice.delete(data, allocators.heap_allocator())
    os.assertf(read_err == nil, "path: %", link_file)

    // LINKS
    links: Links
    res := parse(&links, data)
    if res != nil {
        os.exit(1)
    }
    for &arg in array.slice(&links.args) {
        dst := str.str(&arg.dst)
        src := str.str(&arg.src)
        os.printfln("Symlinking: dst '%' src '%'", dst, src)
        // Is file
        if path.ext(src) != "" {
            symlink_err := os.symlink(dst, src, 0x2)
            if symlink_err != nil {
                os.panicf("SYMLINK DIR FAILED '%' dst '%' src '%'", str.from_union_of_enums(symlink_err), dst, src)
            }
        } else {
            wbuf: [1024]u16
            wkey, _ := os.win32_utf8_to_wstring(dst, allocators.temp_allocator)
            res := win32.ExpandEnvironmentStringsW(wkey, raw_data(&wbuf), len(wbuf))

            symlink_err := os.symlink(dst, src, 0x3)
            if symlink_err != nil {
                os.panicf("SYMLINK FILE FAILED '%' dst '%' src '%'", str.from_union_of_enums(symlink_err), dst, src)
                    // Fix: Not exist.
            }
        }
    }

    os.printfln("Finished!")
}
