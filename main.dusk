import "base:mem/allocators"
import "base:container/array"
import "base:container/str"
import "base:container/strings"
import "base:container/slice"

import "core:os"
import "core:path"
import win32 "core:sys/windows"

import "base:mem"
import "base:intrinsics"
import "core:io"


/* 
dusk build .

.\Symlink_Tool.exe "C:\Users\caior\Desktop\caio\programming\Symlink_Tool\files\file.link" "C:\Users\caior\Desktop\caio\apps"
*/

/* 
(2026-07-12_11h29)
TODO: Do the things after parsing.
*/

main :: proc() {
    os.console_init()
    defer os.console_deinit()
    allocators.temp_allocator_init(0, allocators.heap_allocator())
    defer allocators.temp_allocator_destroy()
    os.init_args()
    when DUSK_OS == .Windows {
        os.init_long_path_support()
    }

    // ARGS
    if !(os.args.len == 3) {
        os.eprintfln(os.ERROR + "Must have 2 arguments: LINK_FILE (absolute), SOURCE_DIR (absolute)")
        os.exit(1)
    }

    // SOURCE DIR
    source_dir := os.args.data[2]
    set_wd_err := os.set_working_directory(source_dir)
    os.assertf(set_wd_err == nil, "path: %", source_dir)

    // LINK FILE
    link_file  := os.args.data[1]
    data, read_err := os.read_entire_file_from_path(link_file, allocators.heap_allocator()) // allocator to be removed
    defer _ = slice.delete(data, allocators.heap_allocator())
    os.assertf(read_err == nil, "path: %", link_file)

    // LINKS
    links: Links
    res := parse(&links, data)
    if res != nil {
        os.exit(1)
    }
    for &arg in array.slice(&links.args) {
        dst := str.str(&arg.dst)
        wbuf: [1024]u16
        wkey, _ := os.win32_string_to_cstring16(dst, allocators.temp_allocator)
        res := win32.ExpandEnvironmentStringsW(wkey, raw_data(&wbuf), len(wbuf))
        os.assert(res != 0)            
        dest_expanded, err := os.win32_utf16_to_string(wbuf[:res], allocators.temp_allocator)

        src := str.str(&arg.src)

        // File
        if path.ext(src) != "" {
            os.printfln("SYMLINK FILE: dst '%' src '%'", dest_expanded, src)
            symlink_err := os.symlink(dest_expanded, src, win32.SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE)
            if symlink_err != nil {
                os.panicf("SYMLINK FILE FAILED '%' dst '%' src '%'", str.from_union_of_enums(symlink_err), dest_expanded, src)
            }
        
        // Directory
        } else {
            os.printfln("SYMLINK DIR: dst '%' src '%'", dest_expanded, src)
        
            symlink_err := os.symlink(dest_expanded, src, win32.SYMBOLIC_LINK_FLAG_DIRECTORY | win32.SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE)
            switch symlink_err {
            case nil:
            case .Exist:
                os.panicf("SYMLINK DIR FAILED 'Already Exists' dst '%' src '%'", dest_expanded, src)
            case:
                os.panicf("SYMLINK DIR FAILED '%' dst '%' src '%'", str.from_union_of_enums(symlink_err), dest_expanded, src)
            }
        }
    }

    os.printfln("Finished!")
}
