import "base:container/str"
// import "base:unicode/utf8"
// import av "base:container/array_view"

import "core:strings_tools"


replace_all_runes :: proc(s: ^str.String($N), old, new: u8) {
    for b, i in str.slice(s) {
        // r, _ := utf8.rune_from_bytes(b)
        if b == old {
            s.data[i] = new
        }
    }
}

path_normalize :: proc(path: ^str.String($N)) {
    if path.len == 0 { return }

    replace_all_runes(path, '\\', '/')

    // Trim last character if it is a `/` (for directories)
    if path.len - 1 == '/' {
        path.len -= 1
    }
}


ext :: proc(path: string) -> string {
    if path[len(path) - 1] == '/' {
        return ""
    }
    for i := int(len(path) - 1); i >= 0; i -= 1 {
        if path[i] == '.' {
            return path[i:]
        }
    }
    return ""
}

/*
    Gets the file extension from a path, including the dot.

    The long file extension is such that short_stem(path) + long_ext(path) = base(path).

    The first dot is used to split off the file extension, unlike `ext` which uses the last dot.

    e.g.
      'name.tar.gz' -> '.tar.gz'
      'name.txt'    -> '.txt'

    Returns an empty string if there is no dot.
    Returns an empty string if there is a trailing path separator.
*/
long_ext :: proc(path: string) -> string {
    if len(path) > 0 && path[len(path) - 1] == '/' {
        // Trailing separator
        return ""
    }

    // Get the basename
    path := path
    if i, found := strings_tools.last_index(path, `/`); found {
        path = path[i+1:]
    }

    if i, found := strings_tools.index_byte(path, '.'); found {
        return path[i:]
    }

    return ""
}
